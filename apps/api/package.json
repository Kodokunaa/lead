{
  "name": "@lead/api",
  "version": "0.1.0",
  "private": true,
  "description": "Project LEAD REST API (NestJS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=../../.env --watch --require @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts"
  },
  "dependencies": {
    "@lead/schema": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "postgres": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
