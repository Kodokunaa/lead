{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lead/web", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lead/api", "dev"],
      "port": 3000
    },
    {
      "name": "web-build",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@lead/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
