# Copy to .env and change the values. Never commit .env.

# Docker services (local development only)
POSTGRES_USER=lead
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lead
MINIO_ROOT_USER=lead-minio
MINIO_ROOT_PASSWORD=change-me-local-only

# API
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# The API runs as lead_app (least privilege). `pnpm db:migrate` sets that role's password
# from this URL, so pick any 12+ character value here.
DATABASE_URL=postgres://lead_app:change-me-app-role@127.0.0.1:5433/lead
# Migrations run as the database owner (the POSTGRES_USER above).
MIGRATION_DATABASE_URL=postgres://lead:change-me-local-only@127.0.0.1:5433/lead
TEST_DATABASE_URL=postgres://lead_app:change-me-app-role@127.0.0.1:5433/lead_test
TEST_MIGRATION_DATABASE_URL=postgres://lead:change-me-local-only@127.0.0.1:5433/lead_test
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# 32 random bytes as base64url; encrypts stored MFA secrets. Same command as above with 32.
MFA_ENCRYPTION_KEY=change-me-run-the-command-with-32-bytes
# Development email goes to .eml files here instead of being sent.
MAIL_OUTBOX_DIR=storage/outbox
REDIS_URL=redis://127.0.0.1:6379

# `pnpm db:seed` creates generated demo accounts with this password (development only).
SEED_PASSWORD=change-me-seed
