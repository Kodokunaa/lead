# Copy to .env and change the values. Never commit .env.

# Docker services (local development only)
POSTGRES_USER=lead
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lead
MINIO_ROOT_USER=lead-minio
MINIO_ROOT_PASSWORD=change-me-local-only

# API
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://lead:change-me-local-only@127.0.0.1:5433/lead
TEST_DATABASE_URL=postgres://lead:change-me-local-only@127.0.0.1:5433/lead_test
REDIS_URL=redis://127.0.0.1:6379
